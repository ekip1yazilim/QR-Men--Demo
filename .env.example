# EKİP1 Dijital Menü — ortam değişkenleri
# Bu dosyayı proje kökünde ".env" adıyla kopyalayın; uygulama açılışta otomatik okur.
# (systemd, Docker gibi ortamlarda tanımlanan değişkenler .env'deki değerlere göre önceliklidir.)
# Bu değerlerin hiçbiri tarayıcıya gönderilmez.

# Sunucunun dinleyeceği port ve adres
PORT=3000
HOST=0.0.0.0

# Veritabanı ve görsellerin saklandığı klasör (menu.db burada oluşur). Yedeklenmesi gereken tek klasör budur.
DATA_DIR=./data

# Menünün kalıcı adresi (QR kod bu adrese göre üretilir). Yönetim panelindeki
# Genel Ayarlar → Site adresi alanı doluysa o önceliklidir. Örnek: https://lezzetduragi.com
SITE_URL=

# Nginx / Caddy gibi bir ters vekil (HTTPS) arkasında çalışıyorsa "true" yapın.
# X-Forwarded-Proto / X-Forwarded-For başlıklarına yalnızca bu durumda güvenilir.
# Sunucu doğrudan internete açıksa "false" bırakın.
TRUST_PROXY=false

# Oturum çerezi: "auto" (HTTPS ise Secure), "true" veya "false"
COOKIE_SECURE=auto

# Oturum süreleri (gün)
SESSION_DAYS=7
REMEMBER_DAYS=30

# En büyük görsel yükleme boyutu (MB)
MAX_UPLOAD_MB=10

# İlk kurulumda `npm run seed` ile oluşturulacak yönetici hesabı (yalnızca hiç hesap yoksa kullanılır)
ADMIN_EMAIL=yonetici@lezzetduragi.com
# ADMIN_PASSWORD boş bırakılırsa güçlü bir rastgele şifre üretilip ekrana yazılır
ADMIN_PASSWORD=
ADMIN_NAME=Restoran Yöneticisi
